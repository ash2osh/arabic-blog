---
import { getLanguageFromPath, useTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
const t = useTranslations(getLanguageFromPath(Astro.url.pathname));
---

<BaseLayout title={t("error.title")} heroTitle={t("error.heroTitle")} noindex>
  <div class="shell missing-page">
    <div class="card page-card">
      <span class="missing-number">404</span>
      <h2>{t("error.heading")}</h2>
      <p>{t("error.description")}</p>
      <a href="/" class="btn">
        {t("error.home")}
      </a>
      <a href="/posts/" class="btn secondary">
        {t("error.posts")}
      </a>
    </div>
  </div>
  <script is:inline>
    // Automatic self-healing redirect for URLs where an underscore was stripped by LinkedIn or external clients
    (function () {
      var path = window.location.pathname;
      var match = path.match(/^(.*\/posts\/)(\d{3})([a-zA-Z].*)$/);
      if (match) {
        var base = match[1];
        var num = match[2];
        var rest = match[3];
        if (!rest.endsWith("/")) rest += "/";
        var target = base + num + "_" + rest;
        window.location.replace(target);
      }
    })();
  </script>
</BaseLayout>
<style>
  .missing-page {
    padding-top: 48px;
    padding-bottom: 64px;
    max-width: 640px;
    text-align: center;
  }
  .missing-number {
    font-size: 64px;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }
  .missing-page h2 {
    font-size: 22px;
    font-weight: 600;
    margin: 16px 0 8px;
  }
  .missing-page p {
    color: var(--muted);
    font-size: 16px;
    margin: 0 0 24px;
  }
  .missing-page .btn {
    margin: 4px;
  }
</style>
